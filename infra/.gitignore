# OpenTofu working directories, plans and local state never go into git.
.tofu/
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
# Lock files belong in git for the root stacks only, generated with `make infra-lock` against the OpenTofu registry.
# Until that has been run from a machine that reaches the registry, the stacks' lock files are ignored too: one
# written from a local provider mirror records checksums the registry's packages do not match. Then delete the
# second line below and commit them.
modules/**/.terraform.lock.hcl
stacks/**/.terraform.lock.hcl
