{
  "name": "@caseforge/client",
  "version": "1.0.0",
  "description": "Client for the CaseForge public API (v1): tokens, pagination, safe retries, events and webhook verification",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p .",
    "types": "openapi-typescript ${CASEFORGE_URL:-http://localhost:8000}/api/v1/openapi.json -o src/schema.d.ts"
  },
  "engines": { "node": ">=20" },
  "devDependencies": { "typescript": "^5.8.0", "openapi-typescript": "^7.6.0" }
}
